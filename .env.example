APPLICATION_PORT=3000
APPLICATION_ENVIRONMENT=development
POSTGRESQL_DATA_SOURCE=host=localhost port=5432 user=afraniocaires password=postgres dbname=ecommerce sslmode=disable
PAYMENT_APPLICATION_PORT=3001
PAYMENT_POSTGRESQL_DATA_SOURCE=host=localhost port=5433 user=payment password=postgres dbname=payments sslmode=disable
JSON_WEB_TOKEN_SECRET=replace-this-local-secret
JSON_WEB_TOKEN_ISSUER=ecommerce
JSON_WEB_TOKEN_LIFETIME=15m
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_COMMAND_EXCHANGE=ecommerce.commands
RABBITMQ_EVENT_EXCHANGE=ecommerce.events
RABBITMQ_PAYMENT_QUEUE=payment.requests
RABBITMQ_RESULT_QUEUE=ecommerce.payment-results
OUTBOX_INTERVAL=250ms
OUTBOX_BATCH_SIZE=20
MESSAGE_RETRY_LIMIT=5
SHUTDOWN_TIMEOUT=5s
